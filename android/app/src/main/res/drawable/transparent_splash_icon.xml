<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 requires a splash icon. A transparent drawable keeps the
     required slot while producing the requested plain-colour launch screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="1dp"
        android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>
